#!/bin/sh
# Lanzador de agy-task: localiza un Python >= 3.11 y ejecuta lib/agy_task.py.
# El `python3` del PATH puede ser más antiguo (el de macOS es 3.9) y el PATH cambia
# de una shell a otra, así que no se puede confiar en `#!/usr/bin/env python3`.
# Para fijar un intérprete concreto: export AGY_BRIDGE_PYTHON=/ruta/a/python3
set -e

self="$0"
while [ -L "$self" ]; do
  dir="$(cd "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$dir/$self" ;; esac
done
root="$(cd "$(dirname "$self")/.." && pwd)"

usable() { [ -x "$1" ] && "$1" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; }

if [ -n "${AGY_BRIDGE_PYTHON:-}" ]; then
  usable "$AGY_BRIDGE_PYTHON" || { echo "agy-task: AGY_BRIDGE_PYTHON no es un Python >= 3.11: $AGY_BRIDGE_PYTHON" >&2; exit 1; }
  exec "$AGY_BRIDGE_PYTHON" "$root/lib/agy_task.py" "$@"
fi

names="python3 python3.15 python3.14 python3.13 python3.12 python3.11"
for name in $names; do
  candidate="$(command -v "$name" 2>/dev/null || true)"
  if [ -n "$candidate" ] && usable "$candidate"; then exec "$candidate" "$root/lib/agy_task.py" "$@"; fi
done
for dir in /opt/homebrew/bin /usr/local/bin /Library/Frameworks/Python.framework/Versions/Current/bin "$HOME/.local/bin"; do
  for name in $names; do
    if usable "$dir/$name"; then exec "$dir/$name" "$root/lib/agy_task.py" "$@"; fi
  done
done
echo "agy-task: no se encontró un Python >= 3.11. Instálalo o define AGY_BRIDGE_PYTHON=/ruta/a/python3." >&2
exit 1
