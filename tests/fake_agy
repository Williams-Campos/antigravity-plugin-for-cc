#!/usr/bin/env python3
"""agy simulado para las pruebas: ejecuta el siguiente paso del guion en $FAKE_AGY_PLAN.

Cada paso es un objeto con claves opcionales:
  write   {ruta: contenido}  archivos que "agy" escribe (rutas relativas al cwd, o absolutas)
  delete  [rutas]            archivos que borra
  so      {...}              reporte estructurado que devuelve
  denied  [...]              acciones denegadas que declara
  sleep   segundos           espera antes de responder (para probar cancelación y timeouts)
  status, rc, stderr, error  para simular fallos del ejecutor

Si hay más llamadas que pasos, se repite el último. Cada llamada (argumentos y cwd) se
registra en <plan>.calls; el acceso está serializado para soportar llamadas en paralelo.
"""
import fcntl
import json
import os
import sys
import time

argv = sys.argv[1:]
if argv[:1] == ["--version"]:
    print("0.0.0-fake")
    sys.exit(0)

plan_path = os.environ["FAKE_AGY_PLAN"]
calls_path = plan_path + ".calls"
with open(plan_path + ".lock", "w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    steps = json.load(open(plan_path))
    calls = json.load(open(calls_path)) if os.path.exists(calls_path) else []
    calls.append({"argv": argv, "cwd": os.getcwd()})
    json.dump(calls, open(calls_path, "w"))
step = steps[min(len(calls) - 1, len(steps) - 1)]

time.sleep(step.get("sleep", 0))
for path, content in step.get("write", {}).items():
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    with open(path, "w") as f:
        f.write(content)
for path in step.get("delete", []):
    os.remove(path)

env = {"conversation_id": "conv-fake", "status": step.get("status", "SUCCESS"), "response": "",
       "usage": {"input_tokens": 100, "output_tokens": 10, "cache_read_tokens": 0}}
for key, field in (("so", "structured_output"), ("denied", "denied_actions"), ("error", "error")):
    if key in step:
        env[field] = step[key]
print(json.dumps(env))
sys.stderr.write(step.get("stderr", ""))
sys.exit(step.get("rc", 0))
