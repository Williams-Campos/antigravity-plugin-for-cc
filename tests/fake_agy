#!/usr/bin/env python3
"""Fake agy for the tests: runs the next step of the script in $FAKE_AGY_PLAN.

Each step is an object with optional keys:
  write   {path: content}    files "agy" writes (paths relative to the cwd, or absolute)
  delete  [paths]            files it deletes
  so      {...}              structured report it returns
  denied  [...]              denied actions it declares
  sleep   seconds            wait before replying (to test cancellation and timeouts)
  run     [shell commands]   commands "agy" runs in its cwd (e.g. git commit)
  status, rc, stderr, error  to simulate executor failures

If there are more calls than steps, the last step repeats. Every call (arguments and cwd) is
logged to <plan>.calls; access is serialised so parallel calls are supported.
"""
import fcntl
import json
import os
import subprocess
import sys
import time

argv = sys.argv[1:]
if argv[:1] == ["--version"]:
    print("0.0.0-fake")
    sys.exit(0)

plan_path = os.environ["FAKE_AGY_PLAN"]
calls_path = plan_path + ".calls"
with open(plan_path + ".lock", "w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    steps = json.load(open(plan_path))
    calls = json.load(open(calls_path)) if os.path.exists(calls_path) else []
    calls.append({"argv": argv, "cwd": os.getcwd()})
    json.dump(calls, open(calls_path, "w"))
step = steps[min(len(calls) - 1, len(steps) - 1)]

time.sleep(step.get("sleep", 0))
for path, content in step.get("write", {}).items():
    os.makedirs(os.path.dirname(os.path.abspath(path)), exist_ok=True)
    with open(path, "w") as f:
        f.write(content)
for path in step.get("delete", []):
    os.remove(path)
for cmd in step.get("run", []):
    subprocess.run(cmd, shell=True, check=True)

env = {"conversation_id": "conv-fake", "status": step.get("status", "SUCCESS"), "response": "",
       "usage": {"input_tokens": 100, "output_tokens": 10, "cache_read_tokens": 0}}
for key, field in (("so", "structured_output"), ("denied", "denied_actions"), ("error", "error")):
    if key in step:
        env[field] = step[key]
print(json.dumps(env))
sys.stderr.write(step.get("stderr", ""))
sys.exit(step.get("rc", 0))
